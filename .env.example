# Placeholder; no tokens/API keys in git
BIDOPS_DATABASE_URL=sqlite:///./data/processed/bidops.sqlite3
BIDOPS_DATA_DIR=./data
BIDOPS_NETWORK_ENABLED=false
BIDOPS_SOURCE_REGISTRY=./config/sources.json
BIDOPS_HTTP_TIMEOUT_SECONDS=15
BIDOPS_HTTP_RATE_LIMIT_SECONDS=5
# .env is documentation only: export variables explicitly in your terminal.
# Network also requires --execute and reviewed per-source permission + exact URL allowlist.
# Agent Demo: configure DEEPSEEK_API_KEY via environment or ignored private/deepseek.env.
# Never put a real key in this example or in browser code.
BIDOPS_DEMO_ENABLED=true
BIDOPS_DEMO_MAX_COST_CNY=10
