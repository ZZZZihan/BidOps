        },
        "individually_reviewed": {
          "default": false,
          "title": "Individually Reviewed",
          "type": "boolean"
        },
        "successor_recomputed": {
          "default": false,
          "title": "Successor Recomputed",
          "type": "boolean"
        },
        "agent_result_unchanged": {
          "default": false,
          "title": "Agent Result Unchanged",
