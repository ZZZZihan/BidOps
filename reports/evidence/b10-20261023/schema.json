        },
        "reviewer_assignment_verified": {
          "default": false,
          "title": "Reviewer Assignment Verified",
          "type": "boolean"
        }
      },
      "required": [
        "owner_account_id",
        "reviewer_account_id",
        "profile_revision",
        "notice_revision",
        "material_revisions",
        "batch_id",
        "run_id",
        "case_id",
        "successor_run_id",
        "export_artifact_id",
        "independent_review_artifact_id"
