{
  "$defs": {
    "AccessObservation": {
      "additionalProperties": false,
      "properties": {
        "actor_account_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor Account Id"
        },
        "target_account_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Account Id"
        },
        "resource": {
          "enum": [
            "material",
            "session",
            "job",
            "role",
            "anonymous"
          ],
          "title": "Resource",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "expected_status": {
          "enum": [
            401,
            403,
            404
          ],
          "title": "Expected Status",
          "type": "integer"
        },
        "observed_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Observed Status",
          "type": "integer"
        }
      },
      "required": [
        "resource",
        "observed_at",
        "expected_status",
        "observed_status"
      ],
      "title": "AccessObservation",
      "type": "object"
    },
    "Account": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Account Id",
          "type": "string"
        },
        "operator_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Operator Id",
          "type": "string"
        },
        "subject_binding_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Subject Binding Sha256",
          "type": "string"
        },
        "roles": {
          "items": {
            "enum": [
              "viewer",
              "analyst",
              "reviewer",
              "auditor",
              "admin"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "actual_human": {
          "default": false,
          "title": "Actual Human",
          "type": "boolean"
        },
        "independent": {
          "default": false,
          "title": "Independent",
          "type": "boolean"
        },
        "developer_or_tuner": {
          "default": true,
          "title": "Developer Or Tuner",
          "type": "boolean"
        },
        "attestation_artifact_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attestation Artifact Id"
        }
      },
      "required": [
        "account_id",
        "operator_id",
        "subject_binding_sha256",
        "roles"
      ],
      "title": "Account",
      "type": "object"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 50000000,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "media_type": {
          "enum": [
            "application/json",
            "text/plain",
            "video/mp4",
            "image/png",
            "application/pdf"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "sensitivity": {
          "const": "private",
          "default": "private",
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "size_bytes",
        "media_type"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "BusinessFlow": {
      "additionalProperties": false,
