# Copy to ignored private/enterprise.env; supply your real enterprise IdP and HTTPS origin.
BIDOPS_ENTERPRISE_ENABLED=true
BIDOPS_ENTERPRISE_ORGANIZATION=BidOps
BIDOPS_ENTERPRISE_PUBLIC_URL=https://bidops.example.invalid
BIDOPS_ENTERPRISE_OIDC_ISSUER=https://identity.example.invalid/realms/bidops
BIDOPS_ENTERPRISE_OIDC_CLIENT_ID=bidops
BIDOPS_ENTERPRISE_OIDC_CLIENT_SECRET=
# Generate locally: uv run python -c 'import secrets; print(secrets.token_urlsafe(48))'
BIDOPS_ENTERPRISE_COOKIE_SECRET=
BIDOPS_ENTERPRISE_SESSION_SECONDS=3600
BIDOPS_ENTERPRISE_HISTORY_DAYS=30
BIDOPS_ENTERPRISE_REQUESTS_PER_MINUTE=20
BIDOPS_DEMO_MAX_COST_CNY=10
BIDOPS_NETWORK_ENABLED=false
# Optional durable jobs, single host / worker; model budget gates remain separate.
BIDOPS_JOBS_ENABLED=false
BIDOPS_JOBS_MAX_ACTIVE_JOBS=100
BIDOPS_REVIEW_ENABLED=false
